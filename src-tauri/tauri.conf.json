{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "REF Lombardia",
  "version": "0.1.1",
  "identifier": "it.reflombardia.app",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "REF Lombardia - Relazione Economico-Finanziaria",
        "zoomHotkeysEnabled": true,
        "width": 1280,
        "height": 860,
        "minWidth": 1000,
        "minHeight": 650,
        "additionalBrowserArgs": "--disable-http-cache --disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": {
      "../src/documenti/": "documenti/"
    }
  }
}
